{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getzilla.app/schemas/release-state-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "published"
  ],
  "properties": {
    "schema_version": {
      "const": "release-state-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "state": {
          "enum": [
            "source_candidate",
            "released"
          ]
        }
      }
    },
    "published": {
      "type": [
        "null",
        "object"
      ],
      "required": [
        "version",
        "tag",
        "tag_object",
        "commit",
        "tree",
        "artifact"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tag_object": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "published_at": {
          "type": "string"
        },
        "artifact": {
          "type": "object",
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "description": "Getzilla release state: source candidate and published release kept apart"
}
