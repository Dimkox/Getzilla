            },
            {
              "type": "null"
            }
          ]
        },
        "cohort_spend_per_accepted": {
          "items": {
            "$ref": "#/$defs/Ratio"
          },
          "maxItems": 32,
          "type": "array"
        },
        "reasons": {
          "items": {
            "enum": [
              "ambiguous",
              "capture_gap",
              "conflicted",
              "currency_missing",
              "history_gap",
              "not_applicable",
              "not_observed",
              "outcome_unknown",
              "redacted",
              "source_unqualified",
              "tariff_missing",
              "unallocated",
              "unknown_denominator",
              "unsupported",
              "zero_denominator"
            ]
          },
          "maxItems": 32,
          "type": "array"
        },
        "rejected_abandoned_share": {
          "items": {
            "$ref": "#/$defs/Ratio"
          },
          "maxItems": 32,
          "type": "array"
        },
        "unsuccessful_attempt_share": {
          "items": {
            "$ref": "#/$defs/Ratio"
          },
          "maxItems": 32,
          "type": "array"
        },
        "unsuccessful_attempt_spend": {
          "items": {
            "$ref": "#/$defs/Money"
          },
          "maxItems": 32,
          "type": "array"
        }
      },
      "required": [
        "accepted_task_mean",
        "accepted_tasks",
        "cohort_spend_per_accepted",
        "reasons",
        "rejected_abandoned_share",
        "unsuccessful_attempt_share",
        "unsuccessful_attempt_spend"
      ],
      "type": "object"
    },
    "Reconciliation": {
      "additionalProperties": false,
      "properties": {
