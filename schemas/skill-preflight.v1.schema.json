{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:getzilla:skill-preflight:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "snapshot_digest", "descriptor_digest", "catalog_digest", "verdict", "reasons", "observations", "permissions_granted", "semantic_safety", "dependency_qualification", "evidence_valid"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "descriptor_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"enum": ["allow", "deny", "needs_review"]},
    "reasons": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}},
    "observations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["OVERLAPPING_READ"]}},
    "permissions_granted": {"const": false},
    "semantic_safety": {"const": "unqualified"},
    "dependency_qualification": {"const": "declared-pins-only"},
    "evidence_valid": {"const": false}
  }
}
