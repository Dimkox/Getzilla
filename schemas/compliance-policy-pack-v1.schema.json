{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:getzilla:compliance-policy-pack:v1",
  "title": "Proposed advisory Compliance Foundation policy pack",
  "description": "Planning-only data contract. Valid data does not authenticate sources/reviewers, activate a pack or establish legal compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "pack_version", "mode", "jurisdiction", "owner_ref", "review", "sources", "rules", "outcomes", "supersedes"],
  "properties": {
    "schema_version": {"const": "compliance-policy-pack-v1"},
    "pack_id": {"$ref": "#/$defs/id"},
    "pack_version": {"$ref": "#/$defs/version"},
    "mode": {"const": "advisory"},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "label", "level", "parent_ids"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "level": {"enum": ["supranational", "national", "federal", "state", "local"]},
        "parent_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "owner_ref": {"$ref": "#/$defs/id"},
    "review": {"$ref": "#/$defs/review"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/source"}},
    "rules": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/rule"}},
    "outcomes": {"const": ["applicable", "not_applicable", "uncertain", "needs_legal_review"]},
    "supersedes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "version": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 40},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_ref", "evidence_ref", "reviewed_at", "valid_until"],
      "description": "References are assertions for an existing trusted verifier to check, never approvals or bearer capabilities.",
      "properties": {
        "status": {"enum": ["draft", "needs_legal_review", "reviewed", "retired"]},
        "reviewer_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "evidence_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "reviewed_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "valid_until": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]},
        "then": {"properties": {
          "reviewer_ref": {"$ref": "#/$defs/id"}, "evidence_ref": {"$ref": "#/$defs/id"},
          "reviewed_at": {"$ref": "#/$defs/time"}, "valid_until": {"$ref": "#/$defs/time"}
        }}
      }]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publication_uri", "publication_version", "content_sha256", "retrieved_at", "review_after"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "publication_uri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "publication_version": {"$ref": "#/$defs/text"},
        "content_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "retrieved_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "review_after": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "operator", "values"],
      "properties": {
        "fact": {"enum": ["product_kind", "purpose_code", "market", "deployment_jurisdiction", "actor_role", "actual_use_code", "affected_population_location"]},
        "operator": {"const": "in"},
        "values": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {"source_id": {"$ref": "#/$defs/id"}, "locator": {"$ref": "#/$defs/text"}}
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "kind", "scope", "description"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["test", "pr", "ci", "audit_bundle", "risk_register", "human_review"]},
        "scope": {"enum": ["platform", "customer_system", "shared"]},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_version", "citations", "effective_from", "effective_until", "all", "evidence_requirements", "severity", "owner_ref", "review"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "rule_version": {"$ref": "#/$defs/version"},
        "citations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/citation"}},
        "effective_from": {"anyOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]},
        "effective_until": {"anyOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]},
        "all": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/condition"}},
        "evidence_requirements": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/evidence_requirement"}},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "owner_ref": {"$ref": "#/$defs/id"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
