{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/session_start.py --harness gemini",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/user_prompt_submit.py --harness gemini",
            "timeout": 20000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_tool_use.py --harness gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/post_tool_use.py --harness gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_compact.py --harness gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/stop_gate.py --harness gemini",
            "timeout": 120000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/session_end.py --harness gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
