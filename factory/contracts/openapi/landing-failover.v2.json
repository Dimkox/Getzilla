{
  "openapi": "3.1.0",
  "info": {
    "title": "Landing backend capability with the patched PDF parser",
    "version": "2.0.0",
    "description": "Authenticated Unix capability discovery. Current callers use GET /v3/landing-backend. The prior endpoint retains its declared failure response when its frozen profile is unavailable. Submission and attempt receipt routes are unchanged."
  },
  "paths": {
    "/v3/landing-backend": {
      "get": {
        "operationId": "getLandingBackendCapabilityV2",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "X-Repository-ID",
            "in": "header",
            "required": true,
            "schema": {
              "const": "github.com/Dimkox/ai-dark-factory-landing"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated bounded receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/landing-backend-capability.v2.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Closed failure; no fallback authority"
          },
          "403": {
            "description": "Closed failure; no fallback authority"
          },
          "404": {
            "description": "Closed failure; no fallback authority"
          },
          "409": {
            "description": "Closed failure; no fallback authority"
          },
          "422": {
            "description": "Closed failure; no fallback authority"
          },
          "500": {
            "description": "Closed failure; no fallback authority"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
