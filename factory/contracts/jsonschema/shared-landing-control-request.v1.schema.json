{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:shared-landing-control-request:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "parent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "media_type": {
      "enum": [
        "text/plain",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "payload_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 699052,
      "contentEncoding": "base64"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "parent_digest",
    "ordinal",
    "profile_digest",
    "source_head",
    "source_tree",
    "media_type",
    "payload_base64"
  ]
}
