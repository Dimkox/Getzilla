{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:getzilla:design-reference:pack:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content",
    "content_digest",
    "capture"
  ],
  "properties": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "extractor_version",
        "parameters",
        "sources",
        "tokens",
        "coverage",
        "browser"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "extractor_version": {
          "const": "0.2.0"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "resources",
            "viewport",
            "theme",
            "locale",
            "scope",
            "live_capture"
          ],
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 512
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 240,
                  "maximum": 1920
                },
                "height": {
                  "type": "integer",
                  "minimum": 240,
                  "maximum": 1920
                }
              }
            },
            "theme": {
              "enum": [
                "light",
                "dark"
              ]
            },
            "locale": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            },
            "scope": {
              "const": "controlled-loopback-fixture"
            },
            "live_capture": {
              "const": "unsupported"
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "maxItems": 16,
          "minItems": 1
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "name",
              "context",
              "raw_value",
              "unit",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "const": "computed"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "name": {
                "enum": [
                  "color",
                  "background-color",
                  "font-family",
                  "font-size",
                  "font-weight",
                  "line-height",
                  "letter-spacing",
                  "margin-top",
                  "padding-top",
                  "gap",
                  "border-radius",
                  "box-shadow"
                ]
              },
              "context": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512
                },
                "maxItems": 33
              },
              "raw_value": {
                "type": "string",
                "maxLength": 4096
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element"
                ],
                "properties": {
                  "element": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  }
                }
              }
            }
          },
          "maxItems": 1536
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reasons",
            "files",
            "tokens"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "enum": [
                  "fixture-only",
                  "dynamic-unproven",
                  "dynamic-content",
                  "blocked-transport",
                  "request-budget",
                  "resource-unavailable",
                  "response-budget",
                  "dom-budget",
                  "fonts-incomplete",
                  "loading-incomplete"
                ]
              }
            },
            "files": {
              "type": "integer",
              "minimum": 1
            },
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1536
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "adapter",
            "adapter_version",
            "sandbox",
            "loading"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9.]{1,64}$"
            },
            "adapter": {
              "const": "playwright"
            },
            "adapter_version": {
              "type": "string",
              "pattern": "^[0-9.]{1,64}$"
            },
            "sandbox": {
              "const": true
            },
            "loading": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fonts",
                "fontErrors",
                "css",
                "ready"
              ],
              "properties": {
                "fonts": {
                  "enum": [
                    "loaded",
                    "loading"
                  ]
                },
                "fontErrors": {
                  "type": "boolean"
                },
                "css": {
                  "type": "boolean"
                },
                "ready": {
                  "enum": [
                    "loading",
                    "interactive",
                    "complete"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
