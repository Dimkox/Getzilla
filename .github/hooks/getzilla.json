{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "for p in python3 python; do if command -v \"$p\" >/dev/null 2>&1 && \"$p\" -c \"import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)\" </dev/null >/dev/null 2>&1; then exec \"$p\" -c \"import os,pathlib,runpy,sys;t='.getzilla/hooks/session_start.py';p=pathlib.Path;d=p.cwd();e=[p(os.environ[k]) for k in ('CLAUDE_PROJECT_DIR','QWEN_PROJECT_DIR','GEMINI_PROJECT_DIR') if os.environ.get(k)];f=next(q/t for q in (*e,d,*d.parents) if (q/'.getzilla/getzilla/__init__.py').is_file() and (q/t).is_file());sys.path.insert(0,str(f.parent));sys.argv=[str(f),'--harness','copilot'];runpy.run_path(str(f),run_name='__main__')\"; fi; done; exit 127",
        "powershell": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "for p in python3 python; do if command -v \"$p\" >/dev/null 2>&1 && \"$p\" -c \"import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)\" </dev/null >/dev/null 2>&1; then exec \"$p\" -c \"import os,pathlib,runpy,sys;t='.getzilla/hooks/user_prompt_submit.py';p=pathlib.Path;d=p.cwd();e=[p(os.environ[k]) for k in ('CLAUDE_PROJECT_DIR','QWEN_PROJECT_DIR','GEMINI_PROJECT_DIR') if os.environ.get(k)];f=next(q/t for q in (*e,d,*d.parents) if (q/'.getzilla/getzilla/__init__.py').is_file() and (q/t).is_file());sys.path.insert(0,str(f.parent));sys.argv=[str(f),'--harness','copilot'];runpy.run_path(str(f),run_name='__main__')\"; fi; done; exit 127",
        "powershell": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 20
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "for p in python3 python; do if command -v \"$p\" >/dev/null 2>&1 && \"$p\" -c \"import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)\" </dev/null >/dev/null 2>&1; then exec \"$p\" -c \"import os,pathlib,runpy,sys;t='.getzilla/hooks/pre_tool_use.py';p=pathlib.Path;d=p.cwd();e=[p(os.environ[k]) for k in ('CLAUDE_PROJECT_DIR','QWEN_PROJECT_DIR','GEMINI_PROJECT_DIR') if os.environ.get(k)];f=next(q/t for q in (*e,d,*d.parents) if (q/'.getzilla/getzilla/__init__.py').is_file() and (q/t).is_file());sys.path.insert(0,str(f.parent));sys.argv=[str(f),'--harness','copilot'];runpy.run_path(str(f),run_name='__main__')\"; fi; done; exit 127",
        "powershell": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "for p in python3 python; do if command -v \"$p\" >/dev/null 2>&1 && \"$p\" -c \"import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)\" </dev/null >/dev/null 2>&1; then exec \"$p\" -c \"import os,pathlib,runpy,sys;t='.getzilla/hooks/post_tool_use.py';p=pathlib.Path;d=p.cwd();e=[p(os.environ[k]) for k in ('CLAUDE_PROJECT_DIR','QWEN_PROJECT_DIR','GEMINI_PROJECT_DIR') if os.environ.get(k)];f=next(q/t for q in (*e,d,*d.parents) if (q/'.getzilla/getzilla/__init__.py').is_file() and (q/t).is_file());sys.path.insert(0,str(f.parent));sys.argv=[str(f),'--harness','copilot'];runpy.run_path(str(f),run_name='__main__')\"; fi; done; exit 127",
        "powershell": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "for p in python3 python; do if command -v \"$p\" >/dev/null 2>&1 && \"$p\" -c \"import sys;sys.exit(0 if sys.version_info >= (3,11) else 1)\" </dev/null >/dev/null 2>&1; then exec \"$p\" -c \"import os,pathlib,runpy,sys;t='.getzilla/hooks/session_end.py';p=pathlib.Path;d=p.cwd();e=[p(os.environ[k]) for k in ('CLAUDE_PROJECT_DIR','QWEN_PROJECT_DIR','GEMINI_PROJECT_DIR') if os.environ.get(k)];f=next(q/t for q in (*e,d,*d.parents) if (q/'.getzilla/getzilla/__init__.py').is_file() and (q/t).is_file());sys.path.insert(0,str(f.parent));sys.argv=[str(f),'--harness','copilot'];runpy.run_path(str(f),run_name='__main__')\"; fi; done; exit 127",
        "powershell": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ; exit $LASTEXITCODE",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
