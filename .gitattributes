# Byte-exact documents, digests and receipts need identical bytes on every OS: never let a
# Windows checkout (core.autocrlf=true by default in Git for Windows) rewrite them to CRLF.
* text=auto eol=lf
# Content-addressed UTF-8 assets retain original bytes, including upstream CRLF.
# Keep normal text diff detection; this only disables newline conversion.
.getzilla/templates/baseline/blobs/*.txt -text
# cmd.exe needs CRLF batch files.
*.cmd text eol=crlf
engineering/changes/20260924-factory-unified-upgrade/FACTORY_TZ_v1.5_ADDENDUM_BB-01.md whitespace=-trailing-space
engineering/changes/20260924-factory-unified-upgrade/FACTORY_UNIFIED_UPGRADE_TZ.md whitespace=-trailing-space
engineering/changes/20261002-assemble-2-1-1-factory-source-with-heartbeat-and-ffb3d8/approved-recovery-design.md whitespace=-trailing-space
scripts/install.sh text eol=lf
scripts/install.ps1 text eol=lf
# Frozen issue162 publication: keep upstream CSV/Markdown bytes and recorded hashes.
engineering/benchmarks/issue162/** -text whitespace=-trailing-space
# Frozen issue170 observations retain original CSV line endings and log bytes.
engineering/benchmarks/issue170/** -text whitespace=-trailing-space
# Retained upstream licence input is bound to its original complete bytes.
.getzilla/config/license-exception-inputs/ci-internal-v1/MPL-2.0-debian.txt -text whitespace=-trailing-space
