{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/session_start.py --harness qwen",
            "timeout": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/user_prompt_submit.py --harness qwen",
            "timeout": 20000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_tool_use.py --harness qwen",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/post_tool_use.py --harness qwen",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_compact.py --harness qwen",
