{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/session_start.py --harness grok",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/user_prompt_submit.py --harness grok",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_tool_use.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/post_tool_use.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/pre_compact.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/subagent_start.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/subagent_stop.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/stop_gate.py --harness grok",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "getzilla hook --script .getzilla/hooks/session_end.py --harness grok",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
