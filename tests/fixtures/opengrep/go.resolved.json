{"rules":[{"id":"getzilla.go.sql-injection","languages":["go"],"message":"Request data is formatted into a SQL string. Use placeholders and pass values as arguments.","metadata":{"confidence":"MEDIUM","cwe":"CWE-89","owasp":"A03:2021"},"mode":"taint","pattern-sanitizers":[{"pattern":"strconv.Atoi(...)"}],"pattern-sinks":[{"patterns":[{"pattern-either":[{"pattern":"$DB.Query($Q, ...)"},{"pattern":"$DB.QueryRow($Q, ...)"},{"pattern":"$DB.Exec($Q, ...)"},{"pattern":"$DB.QueryContext($CTX, $Q, ...)"},{"pattern":"$DB.ExecContext($CTX, $Q, ...)"}]},{"focus-metavariable":"$Q"}]}],"pattern-sources":[{"pattern-either":[{"pattern":"$R.URL.Query().Get(...)"},{"pattern":"$R.URL.Query()"},{"pattern":"$R.FormValue(...)"},{"pattern":"$R.PostFormValue(...)"},{"pattern":"$R.Header.Get(...)"},{"pattern":"($C *gin.Context).Query(...)"},{"pattern":"($C *gin.Context).Param(...)"},{"pattern":"os.Args"}]}],"severity":"ERROR"},{"id":"getzilla.go.command-injection","languages":["go"],"message":"Request data reaches a shell command line. Run the program directly with separate arguments.","metadata":{"confidence":"MEDIUM","cwe":"CWE-78","owasp":"A03:2021"},"mode":"taint","pattern-sinks":[{"patterns":[{"pattern-either":[{"pattern":"exec.Command(\"sh\", \"-c\", $C)"},{"pattern":"exec.Command(\"bash\", \"-c\", $C)"},{"pattern":"exec.CommandContext($CTX, \"sh\", \"-c\", $C)"},{"pattern":"exec.CommandContext($CTX, \"bash\", \"-c\", $C)"}]},{"focus-metavariable":"$C"}]}],"pattern-sources":[{"pattern-either":[{"pattern":"$R.URL.Query().Get(...)"},{"pattern":"$R.URL.Query()"},{"pattern":"$R.FormValue(...)"},{"pattern":"$R.PostFormValue(...)"},{"pattern":"$R.Header.Get(...)"},{"pattern":"($C *gin.Context).Query(...)"},{"pattern":"($C *gin.Context).Param(...)"},{"pattern":"os.Args"}]}],"severity":"ERROR"},{"id":"getzilla.go.ssrf","languages":["go"],"message":"Request data chooses the URL of a server-side request. Allow-list hosts before fetching.","metadata":{"confidence":"MEDIUM","cwe":"CWE-918","owas