{
  "schema_version": 1,
  "authority": "illustrative-example-only",
  "status_context": "adaptive-trust-ci/verified",
  "pipeline": "pull_request",
  "checkout_depth": 250,
  "lease_seconds": 300,
  "max_attempts": 3,
  "max_approval_ttl_seconds": 1800,
  "max_output_bytes": 200000,
  "allowed_environment": [],
  "sandbox": {
    "runtime": "docker",
    "image": "adaptive-trust-ci-runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "user": "10001:10001",
    "memory_mb": 4096,
    "cpus": 2.0,
    "pids_limit": 512,
    "tmpfs_mb": 1024
  },
  "approval_rules": [
    {
      "scope": "governance",
      "globs": [
        ".grok/**",
        ".getzilla/**",
        "AGENTS.md",
        "decisions.md",
        "mistakes.md",
        "Makefile",
        "scripts/getzilla_approve.py",
        "scripts/getzilla_review.py",
        "scripts/getzilla_verify.py",
        "trust-ci/**"
      ]
    },
    {
      "scope": "database",
      "globs": [
        "**/migrations/**",
        "**/sql/**",
        "**/*.sql"
      ]
    },
    {
      "scope": "production",
      "globs": [
        ".github/**",
        "**/Dockerfile",
        "**/compose*.yml",
        "**/compose*.yaml",
        "**/systemd/**",
        "infra/**",
        "terraform/**"
      ]
    }
  ],
  "repository_profiles": [
    {
      "repository": "Dimkox/Getzilla",
      "commands": [
        {
          "name": "root-unittest",
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests"
          ],
          "timeout_seconds": 900,
          "required": true
        },
        {
          "name": "trust-ci-unittest",
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "trust-ci/tests"
          ],
          "timeout_seconds": 900,
          "required": true
        },
        {
          "name": "compileall",
          "argv": [
            "python3",
            "-m",
            "compileall",
            "-q",
            ".getzilla/getzilla",
            "scripts",
            "trust-ci/src"
          ],
          "timeout_seconds": 300,
          "required": true
        },
        {
          "name": "repository-verification",
          "argv": [
            "python3",
            "scripts/getzilla_verify.py",
            "--mode",
            "pr",
            "--no-record",
            "--json"
          ],
          "timeout_seconds": 1200,
          "required": true
        }
      ],
      "holdout": {
        "path": "/etc/adaptive-trust-ci/holdout/getzilla",
        "host_path": "/etc/adaptive-trust-ci/holdout/getzilla",
        "digest": "3e4aff00e0d050254bd3bd833972ceb1d8f372dcad8221d98625b0bdbc39e485",
        "commands": [
          {
            "name": "adaptive-holdout",
            "argv": [
              "python3",
              "/holdout/validate.py",
              "/workspace"
            ],
            "timeout_seconds": 300,
            "required": true
          }
        ]
      }
    },
    {
      "repository": "Dimkox/ii-tonya-platform",
      "commands": [
        {
          "name": "platform-unit",
          "argv": [
            "pytest",
            "-q"
          ],
          "timeout_seconds": 900,
          "required": true
        },
        {
          "name": "platform-compile",
          "argv": [
            "python3",
            "-m",
            "compileall",
            "-q",
            "."
          ],
          "timeout_seconds": 300,
          "required": true
        }
      ],
      "holdout": {
        "path": "/etc/adaptive-trust-ci/holdout/ii-tonya-platform",
        "host_path": "/etc/adaptive-trust-ci/holdout/ii-tonya-platform",
        "digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "commands": [
          {
            "name": "platform-holdout",
            "argv": [
              "python3",
              "/holdout/validate.py",
              "/workspace"
            ],
            "timeout_seconds": 300,
            "required": true
          }
        ]
      }
    }
  ]
}
