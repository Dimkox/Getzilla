ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/adaptive-trust-ci
COPY pyproject.toml README.md ./
COPY uv.lock lock_profiles.py lock-profiles.json requirements-*.txt ./
COPY src ./src
COPY tests ./tests
COPY sql ./sql
RUN python lock_profiles.py --check \
    && python -m pip install --no-cache-dir --require-hashes --only-binary=:all: --no-deps -r requirements-test.txt \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation .

CMD ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_postgres_integration.py", "-v"]
