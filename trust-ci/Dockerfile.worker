ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 trustci \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/trustci trustci \
    && mkdir -p /var/lib/adaptive-trust-ci/workspaces /run/adaptive-trust-ci \
    && chown -R 10001:10001 /var/lib/adaptive-trust-ci /run/adaptive-trust-ci

WORKDIR /opt/adaptive-trust-ci
COPY pyproject.toml README.md requirements.txt requirements-build.txt ./
COPY src ./src
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.txt -r requirements-build.txt \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation .

# Optional public-mode checker distribution. All three operator pins are
# required together; unset keeps the original private image. The checker source
# is fetched independently of this candidate build context and retains genuine
# Git identity/configuration. This does not approve the initial accepted pin.
ARG PUBLIC_CHECKER_REPOSITORY
ARG PUBLIC_CHECKER_COMMIT
ARG PUBLIC_CHECKER_TREE
ARG PUBLIC_CHECKER_INPUTS=public-checker-inputs
COPY ${PUBLIC_CHECKER_INPUTS}/ /opt/public-checker-inputs/
COPY scripts/install_public_checker.py /usr/local/lib/install_public_checker.py
RUN python -I -B /usr/local/lib/install_public_checker.py \
    --repository "$PUBLIC_CHECKER_REPOSITORY" \
    --commit "$PUBLIC_CHECKER_COMMIT" \
    --tree "$PUBLIC_CHECKER_TREE"

USER 10001:10001
ENTRYPOINT ["adaptive-trust-ci"]
CMD ["worker"]
