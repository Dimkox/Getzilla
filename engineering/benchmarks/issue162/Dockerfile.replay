FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
COPY execution/packages.stdout /tmp/requirements-observed.txt
RUN pip install --no-cache-dir -r /tmp/requirements-observed.txt
ENV PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false TIKTOKEN_CACHE_DIR=/codec
WORKDIR /work
