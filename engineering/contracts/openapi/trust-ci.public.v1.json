{
  "openapi": "3.1.0",
  "info": {
    "title": "Trust CI explicit public mode",
    "version": "1"
  },
  "paths": {
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "description": "Local ingress/journal availability only; never publication or merge qualification",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/github": {
      "post": {
        "description": "Bounded authenticated wakeup only. Body authority/evidence claims are ignored; currentness is independently revalidated by the canonical worker.",
        "parameters": [
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^sha256=[0-9a-f]{64}$"
            }
          },
          {
            "name": "x-github-event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "x-github-delivery",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wakeup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wakeup"
                }
              }
            }
          },
          "400": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "401": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "403": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "408": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "413": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "503": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        }
      }
    },
    "/public/jobs/{job_id}": {
      "get": {
        "security": [
          {
            "readBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          },
          "404": {
            "description": "Refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "readBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Live": {
        "type": "object",
        "required": [
          "status",
          "mode",
          "stopped"
        ],
        "properties": {
          "status": {
            "const": "live"
          },
          "mode": {
            "const": "public"
          },
          "stopped": {
            "type": "boolean"
          }
        }
      },
      "Ready": {
        "type": "object",
        "required": [
          "status",
          "admission"
        ],
        "properties": {
          "status": {
            "const": "public-ingress-ready"
          },
          "admission": {
            "const": "not-a-publication-or-merge-verdict"
          }
        }
      },
      "Wakeup": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "job_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "job_id",
          "pr_number",
          "state",
          "reason"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "published",
              "blocked",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "Refusal": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
